{
  "name": "@codeksnet/events-infra",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild handlers/index.ts --bundle --platform=node --target=node22 --external:@aws-sdk/* --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "preview": "pnpm build && pulumi preview",
    "up": "pnpm build && pulumi up"
  },
  "dependencies": {
    "@pulumi/aws": "^7.53.0",
    "@pulumi/pulumi": "^3.274.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
