# Copy to .env.local for local dev. Real secrets live in Coolify — never commit them.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only: the evals dashboard reads evals.runs with this. Set in Coolify.
SUPABASE_SERVICE_KEY=
# Tenant demo only: password for the two fake demo users (alice@acme.test, bob@globex.test)
DEMO_PASSWORD=
# Events demo front (from `pulumi stack output`). Server-side only.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EVENT_BUS_NAME=
TRAIL_TABLE=
# Data demo. Scraper worker (Coolify cron) needs DATABASE_URL; the correction tool uses the Supabase vars above.
DATABASE_URL=
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
REQUEST_DELAY_S=1.0
NEXT_PUBLIC_METABASE_URL=
